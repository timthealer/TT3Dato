{
  "id": "telegram",
  "name": "Telegram Channel",
  "version": "0.2.0",
  "status": "CANDIDATE",
  "priority": "active",
  "description": "Канал связи владельца с HuckleberryFinn через Telegram. Бот = тупой приёмник: пишет сообщения в Telegram/inbox/ репозитория TT3Dato, без LLM. Транспорт webhook (Vercel serverless), безопасность по образцу Aegis (токен из env, доступ только владельца).",
  "source": "https://github.com/DukeDeSouth/aegis",
  "license": "MIT",
  "entrypoints": ["webhook"],
  "transport": "webhook",
  "capabilities": ["chat", "inbox", "notifications"],
  "no_llm": true,
  "funnel": {
    "target_repo": "timthealer/TT3Dato",
    "inbox_path": "Telegram/inbox/YYYY-MM-DD.md",
    "processed_to": "Memory/unverified/ (политика ecc.memory.v1)"
  },
  "owner_only": true,
  "owner": {
    "chat_id": 5255559756,
    "username": "@klysheuski"
  },
  "owner_guard": {
    "implemented": true,
    "status": "PR_PENDING",
    "branch": "260802-sec-owner-allowlist",
    "note": "Ветка содержит allowlist OWNER_CHAT_ID (fail-closed), фикс ceoRules.ts, типчек и funnel. Ждёт merge + деплоя на Vercel."
  },
  "config_refs": {
    "api_key_env": "BOT_TOKEN",
    "owner_chat_id_env": "OWNER_CHAT_ID",
    "github_token_env": "GITHUB_TOKEN",
    "config_file": "connector.example.json"
  },
  "bot": {
    "username": "HuckleberryFinn18Bot",
    "display_name": "HuckleberryFinnBot",
    "id": 8843580192
  },
  "references": ["External/README.md", "External/telegram/connector.example.json", "Telegram/README.md"]
}
